# Environment variables for Smart Expense Tracker & AI Advisor
FLASK_APP=run.py
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# SQLite database (default for MVP)
DATABASE_URL=sqlite:///smart_tracker.db

# PostgreSQL example (for production migration):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_tracker

# Google Gemini API Key for AI Financial Advisor
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
